@model TestRun

@{
    ViewData["Title"] = $"Test Run #{Model.Id}";
}

<h1>Test Run #@Model.Id</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-header">Test Case Information</div>
            <div class="card-body">
                <h5><a asp-controller="TestCases" asp-action="Details" asp-route-id="@Model.TestCaseId">@Model.TestCase.Title</a></h5>
                <p class="text-muted">Test Case ID: #@Model.TestCaseId</p>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4">
                <strong>Result</strong>
                <br />
                <span class="badge @(Model.Result == TestResult.Pass ? "bg-success" : Model.Result == TestResult.Fail ? "bg-danger" : "bg-warning")">
                    @Model.Result
                </span>
            </div>
            <div class="col-md-4">
                <strong>Executed By</strong>
                <br />
                @Model.ExecutedBy
            </div>
            <div class="col-md-4">
                <strong>Executed Date</strong>
                <br />
                @Model.ExecutedDate.ToString("g")
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ActualResult))
        {
            <div class="card mb-3">
                <div class="card-header">Actual Result</div>
                <div class="card-body">
                    <p>@Model.ActualResult</p>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="card mb-3">
                <div class="card-header">Notes</div>
                <div class="card-body">
                    <p>@Model.Notes</p>
                </div>
            </div>
        }

        @if (Model.LinkedBug != null)
        {
            <div class="card mb-3 border-danger">
                <div class="card-header bg-danger text-white">
                    <i class="bi bi-bug"></i> Linked Bug
                </div>
                <div class="card-body">
                    <h5><a asp-controller="Bugs" asp-action="Details" asp-route-id="@Model.LinkedBug.Id" class="text-danger">@Model.LinkedBug.Title</a></h5>
                    <p>Status: @Model.LinkedBug.Status | Priority: @Model.LinkedBug.Priority | Severity: @Model.LinkedBug.Severity</p>
                    <a asp-controller="Bugs" asp-action="Details" asp-route-id="@Model.LinkedBug.Id" class="btn btn-sm btn-danger">
                        View Bug
                    </a>
                </div>
            </div>
        }

        <div class="mt-3">
            <a asp-controller="TestCases" asp-action="Details" asp-route-id="@Model.TestCaseId" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Test Case
            </a>
        </div>
    </div>
</div>