@model TestRun
@inject BugTrack.Services.BugStatusService BugStatusService

@{
    ViewData["Title"] = $"Test Run #{Model.Id}";
}

<div class="page-head">
    <div>
        <div class="page-kicker">Execution Record #@Model.Id.ToString("D4")</div>
        <h1 class="page-title">Test Run</h1>
        <div class="meta-line">
            <span>test case <strong>@Model.TestCase.Title</strong></span>
            <span>run by <strong>@Model.ExecutedBy</strong></span>
            <span>on <strong>@Model.ExecutedDate.ToString("g")</strong></span>
        </div>
    </div>
    <div class="page-actions">
        <a asp-controller="TestCases" asp-action="Details" asp-route-id="@Model.TestCaseId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Test Case
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="ticket mb-4" style="max-width:620px;">
            <div class="ticket-title">
                <span>RESULT SLIP · RUN #@Model.Id</span>
                <time>@Model.ExecutedDate.ToString("dd MMM yyyy HH:mm")</time>
            </div>
            <div class="ticket-row">
                <span class="k">Verdict</span>
                <span class="badge @(Model.Result == TestResult.Pass ? "bg-success" : Model.Result == TestResult.Fail ? "bg-danger" : "bg-warning")">
                    @Model.Result
                </span>
            </div>
            <div class="ticket-row">
                <span class="k">Test Case</span>
                <span class="v">#@Model.TestCaseId @Model.TestCase.Title</span>
            </div>
            <div class="ticket-row">
                <span class="k">Executed By</span>
                <span class="v">@Model.ExecutedBy</span>
            </div>
            <div class="ticket-row">
                <span class="k">Module</span>
                <span class="v">@(Model.TestCase.Module ?? "N/A")</span>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ActualResult))
        {
            <div class="card glass-panel mb-4">
                <div class="card-header"><i class="bi bi-terminal"></i> Actual Result</div>
                <div class="card-body">
                    <pre>@Model.ActualResult</pre>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="card glass-panel mb-4">
                <div class="card-header"><i class="bi bi-sticky"></i> Notes</div>
                <div class="card-body">
                    <p style="white-space:pre-wrap;margin:0;">@Model.Notes</p>
                </div>
            </div>
        }

        @if (Model.LinkedBug != null)
        {
            <div class="card glass-panel mb-4 border-danger">
                <div class="card-header">
                    <i class="bi bi-bug text-danger"></i> Linked Bug
                </div>
                <div class="card-body">
                    <h5 class="card-title">
                        <a asp-controller="Bugs" asp-action="Details" asp-route-id="@Model.LinkedBug.Id" class="text-danger">@Model.LinkedBug.Title</a>
                    </h5>
                    <p class="font-mono mb-0" style="font-size:.85rem;color:var(--ink-mute);">
                        @BugStatusService.GetStatusDisplayName(Model.LinkedBug.Status) · @Model.LinkedBug.Priority · @Model.LinkedBug.Severity
                    </p>
                    <a asp-controller="Bugs" asp-action="Details" asp-route-id="@Model.LinkedBug.Id" class="btn btn-sm btn-outline-danger mt-3">
                        View Bug
                    </a>
                </div>
            </div>
        }
    </div>
</div>