<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BugTrack</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Instrument+Serif:ital@0;1&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    }

    <nav class="app-nav" aria-label="Primary">
        <div class="app-nav-inner">
            <a class="app-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><i class="bi bi-bug-fill"></i></span>
                <span class="brand-word">BugTrack</span>
            </a>
            <div class="app-nav-links">
                <a class="app-nav-link @(controller == "Home" ? "is-active" : "")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i><span>Dashboard</span>
                </a>
                <a class="app-nav-link @(controller == "Bugs" ? "is-active" : "")" asp-controller="Bugs" asp-action="Index">
                    <i class="bi bi-exclamation-octagon"></i><span>Bugs</span>
                </a>
                <a class="app-nav-link @(controller == "TestCases" ? "is-active" : "")" asp-controller="TestCases" asp-action="Index">
                    <i class="bi bi-list-check"></i><span>Test Cases</span>
                </a>
            </div>
        </div>
    </nav>

    <main class="container app-main" role="main">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="app-footer">
        <span>&copy; 2026 BugTrack · Bug &amp; Test Case Management</span>
        <span>QA Signal · Dark Glass · Indigo</span>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>