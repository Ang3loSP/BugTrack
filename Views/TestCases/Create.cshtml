@model BugTrack.Models.TestCase

@{
    ViewData["Title"] = "New Test Case";
}

<div class="page-head">
    <div>
        <div class="page-kicker">New Entry</div>
        <h1 class="page-title">Write a Test Case</h1>
        <p class="page-sub">Define the scenario precisely enough that anyone can execute it.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card glass-panel">
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g., Verify login with valid credentials" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Module" class="form-label"></label>
                                <input asp-for="Module" class="form-control" placeholder="e.g., Auth" />
                                <span asp-validation-for="Module" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Priority" class="form-label"></label>
                                <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<TestPriority>()"></select>
                                <span asp-validation-for="Priority" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Preconditions" class="form-label"></label>
                        <textarea asp-for="Preconditions" class="form-control" rows="2" placeholder="State required before the test can run..."></textarea>
                        <span asp-validation-for="Preconditions" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Steps" class="form-label"></label>
                        <textarea asp-for="Steps" class="form-control" rows="5" placeholder="1. Navigate to...&#10;2. Perform...&#10;3. Confirm..."></textarea>
                        <span asp-validation-for="Steps" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="ExpectedResult" class="form-label"></label>
                        <textarea asp-for="ExpectedResult" class="form-control" rows="3" placeholder="What should happen for the test to pass?"></textarea>
                        <span asp-validation-for="ExpectedResult" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <input type="submit" value="Create Test Case" class="btn btn-success" />
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}