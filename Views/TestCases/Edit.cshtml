@model BugTrack.Models.TestCase

@{
    ViewData["Title"] = $"Edit Test Case #{Model.Id}";
}

<div class="page-head">
    <div>
        <div class="page-kicker">Test Case #@Model.Id.ToString("D4")</div>
        <h1 class="page-title">Edit Test Case</h1>
        <p class="page-sub">Keep the steps in sync with the product.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Details
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card glass-panel">
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="form-group mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Module" class="form-label"></label>
                                <input asp-for="Module" class="form-control" />
                                <span asp-validation-for="Module" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Priority" class="form-label"></label>
                                <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<TestPriority>()"></select>
                                <span asp-validation-for="Priority" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Preconditions" class="form-label"></label>
                        <textarea asp-for="Preconditions" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Preconditions" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Steps" class="form-label"></label>
                        <textarea asp-for="Steps" class="form-control" rows="5"></textarea>
                        <span asp-validation-for="Steps" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="ExpectedResult" class="form-label"></label>
                        <textarea asp-for="ExpectedResult" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="ExpectedResult" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <input type="submit" value="Save Changes" class="btn btn-primary" />
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}