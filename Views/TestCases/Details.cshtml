@model TestCase

@{
    ViewData["Title"] = $"Test Case #{Model.Id} - {Model.Title}";
}

<div class="page-head">
    <div>
        <div class="page-kicker">Test Case #@Model.Id.ToString("D4")</div>
        <h1 class="page-title">@Model.Title</h1>
        <div class="meta-line">
            <span>module <strong>@(Model.Module ?? "N/A")</strong></span>
            <span>created <strong>@Model.CreatedDate.ToString("g")</strong></span>
            <span>id <strong>@Model.Id</strong></span>
        </div>
    </div>
    <div class="page-actions">
        <a asp-controller="TestRuns" asp-action="Create" asp-route-testCaseId="@Model.Id" class="btn btn-success">
            <i class="bi bi-play-fill"></i> Execute Test
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="meta-chip-group">
    <span class="meta-chip">
        <i class="bi bi-fire"></i> Priority
        <span class="badge @(Model.Priority == TestPriority.High ? "bg-danger" : Model.Priority == TestPriority.Medium ? "bg-warning" : "bg-info")">
            @Model.Priority
        </span>
    </span>
    <span class="meta-chip">
        <i class="bi bi-activity"></i> Execution History
        <span class="font-mono">@Model.TestRuns.Count runs</span>
    </span>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        @if (!string.IsNullOrEmpty(Model.Preconditions))
        {
            <div class="card glass-panel mb-4">
                <div class="card-header"><i class="bi bi-gear"></i> Preconditions</div>
                <div class="card-body">
                    <p style="white-space:pre-wrap;margin:0;">@Model.Preconditions</p>
                </div>
            </div>
        }

        <div class="card glass-panel mb-4">
            <div class="card-header"><i class="bi bi-list-ol"></i> Steps</div>
            <div class="card-body">
                <pre>@Model.Steps</pre>
            </div>
        </div>

        <div class="card glass-panel">
            <div class="card-header"><i class="bi bi-check2-square"></i> Expected Result</div>
            <div class="card-body">
                <p style="white-space:pre-wrap;margin:0;">@Model.ExpectedResult</p>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card glass-panel">
            <div class="card-header"><i class="bi bi-clock-history"></i> Execution History</div>
            <div class="card-body">
                @if (Model.TestRuns.Any())
                {
                    <div class="ticket">
                        <div class="ticket-title">
                            <span>RUN LOG · @Model.TestRuns.Count ENTRIES</span>
                        </div>
                        @foreach (var run in Model.TestRuns.OrderByDescending(r => r.ExecutedDate))
                        {
                            <div class="ticket-row">
                                <span class="k">@run.ExecutedDate.ToString("g")</span>
                                <span class="badge @(run.Result == TestResult.Pass ? "bg-success" : run.Result == TestResult.Fail ? "bg-danger" : "bg-warning")">
                                    @run.Result
                                </span>
                            </div>
                            <div class="ticket-row" style="border-bottom:0;padding-top:0;font-size:.76rem;">
                                <span class="k">
                                    by @run.ExecutedBy
                                    @if (run.LinkedBug != null)
                                    {
                                        <a asp-controller="Bugs" asp-action="Details" asp-route-id="@run.LinkedBug.Id" style="margin-left:.4rem;">
                                            <i class="bi bi-bug"></i> Bug #@run.LinkedBug.Id
                                        </a>
                                    }
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(run.Notes))
                            {
                                <div class="ticket-row" style="border-bottom:0;padding-top:0;font-size:.74rem;">
                                    <span class="k">@run.Notes</span>
                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">
                        No executions yet. Run it to start building the history.
                    </p>
                }
            </div>
        </div>
    </div>
</div>