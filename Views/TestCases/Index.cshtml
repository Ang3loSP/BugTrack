@model TestCaseListViewModel

@{
    ViewData["Title"] = "Test Cases";
}

<div class="page-head">
    <div>
        <div class="page-kicker">Test Suite</div>
        <h1 class="page-title">Test Cases</h1>
        <p class="page-sub">The executable checklist for the product. Run them, record results, file bugs.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> New Test Case
        </a>
    </div>
</div>

<div class="card glass-panel mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Module</label>
                <input asp-for="FilterModule" class="form-control" placeholder="Filter by module..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">Priority</label>
                <select asp-for="FilterPriority" class="form-select" asp-items="Html.GetEnumSelectList<TestPriority>()">
                    <option value="">All</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Search</label>
                <div class="input-group">
                    <input asp-for="SearchTerm" class="form-control" placeholder="Search test cases..." />
                    <button type="submit" class="btn btn-primary" aria-label="Search">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg"></i> Clear
                </a>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Module</th>
                <th>Priority</th>
                <th>Created</th>
                <th>Runs</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.TestCases.Any())
            {
                @foreach (var testCase in Model.TestCases)
                {
                    var lastRun = testCase.TestRuns.OrderByDescending(r => r.ExecutedDate).FirstOrDefault();
                    var passCount = testCase.TestRuns.Count(r => r.Result == TestResult.Pass);
                    var totalRuns = testCase.TestRuns.Count;

                    <tr>
                        <td class="id-cell">#@testCase.Id</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@testCase.Id"><strong>@testCase.Title</strong></a>
                        </td>
                        <td>@(testCase.Module ?? "N/A")</td>
                        <td>
                            <span class="badge @(testCase.Priority == TestPriority.High ? "bg-danger" : testCase.Priority == TestPriority.Medium ? "bg-warning" : "bg-info")">
                                @testCase.Priority
                            </span>
                        </td>
                        <td class="font-mono" style="font-size:.85rem;">@testCase.CreatedDate.ToString("d")</td>
                        <td>
                            <span class="font-mono" style="font-size:.9rem;color:var(--ink);">@totalRuns runs</span>
                            @if (totalRuns > 0)
                            {
                                <div class="font-mono" style="font-size:.72rem;color:var(--ink-mute);">
                                    Pass: @passCount (@((passCount * 100 / totalRuns).ToString("F0"))%)
                                </div>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@testCase.Id" class="btn btn-sm btn-info" aria-label="Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@testCase.Id" class="btn btn-sm btn-outline-primary" aria-label="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-controller="TestRuns" asp-action="Create" asp-route-testCaseId="@testCase.Id" class="btn btn-sm btn-success" aria-label="Execute">
                                <i class="bi bi-play-fill"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-5">
                        No test cases found. <a asp-action="Create">Write the first one</a>.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>