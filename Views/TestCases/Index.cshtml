@model TestCaseListViewModel

@{
    ViewData["Title"] = "Test Cases";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-list-check"></i> Test Cases</h1>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> New Test Case
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Module</label>
                <input asp-for="FilterModule" class="form-control" placeholder="Filter by module..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">Priority</label>
                <select asp-for="FilterPriority" class="form-select" asp-items="Html.GetEnumSelectList<TestPriority>()">
                    <option value="">All</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Search</label>
                <div class="input-group">
                    <input asp-for="SearchTerm" class="form-control" placeholder="Search test cases..." />
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Module</th>
                <th>Priority</th>
                <th>Created</th>
                <th>Runs</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.TestCases.Any())
            {
                @foreach (var testCase in Model.TestCases)
                {
                    var lastRun = testCase.TestRuns.OrderByDescending(r => r.ExecutedDate).FirstOrDefault();
                    var passCount = testCase.TestRuns.Count(r => r.Result == TestResult.Pass);
                    var totalRuns = testCase.TestRuns.Count;

                    <tr>
                        <td>#@testCase.Id</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@testCase.Id">@testCase.Title</a>
                        </td>
                        <td>@(testCase.Module ?? "N/A")</td>
                        <td>
                            <span class="badge @(testCase.Priority == TestPriority.High ? "bg-danger" : testCase.Priority == TestPriority.Medium ? "bg-warning" : "bg-info")">
                                @testCase.Priority
                            </span>
                        </td>
                        <td>@testCase.CreatedDate.ToString("d")</td>
                        <td>
                            @totalRuns runs
                            @if (totalRuns > 0)
                            {
                                <br />
                                <small class="text-muted">Pass: @passCount (@((passCount * 100 / totalRuns).ToString("F0"))%)</small>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@testCase.Id" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@testCase.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-controller="TestRuns" asp-action="Create" asp-route-testCaseId="@testCase.Id" class="btn btn-sm btn-success">
                                <i class="bi bi-play"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">No test cases found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>