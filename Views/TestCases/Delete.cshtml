@model BugTrack.Models.TestCase

@{
    ViewData["Title"] = $"Delete Test Case #{Model.Id}";
}

<div class="page-head">
    <div>
        <div class="page-kicker" style="color:var(--danger);">Destructive Action</div>
        <h1 class="page-title">Delete Test Case</h1>
        <p class="page-sub">Removing a test case is permanent. Review before committing.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Details
        </a>
    </div>
</div>

<div class="alert alert-danger">
    <h5><i class="bi bi-exclamation-triangle"></i> Are you sure you want to delete this test case?</h5>
    <p class="mb-0">This action cannot be undone.</p>
</div>

@if ((int)ViewBag.TestRunCount > 0)
{
    <div class="alert alert-warning">
        <h6><i class="bi bi-exclamation-triangle"></i> This test case has @ViewBag.TestRunCount execution run(s).</h6>
        <p class="mb-0">Test cases with execution history cannot be deleted, because test run history must be preserved.</p>
    </div>
}

<div class="card glass-panel">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3">Module</dt>
            <dd class="col-sm-9">@(Model.Module ?? "N/A")</dd>

            <dt class="col-sm-3">Priority</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.Priority == TestPriority.High ? "bg-danger" : Model.Priority == TestPriority.Medium ? "bg-warning" : "bg-info")">
                    @Model.Priority
                </span>
            </dd>

            <dt class="col-sm-3">Steps</dt>
            <dd class="col-sm-9"><pre class="mb-0">@Model.Steps</pre></dd>

            <dt class="col-sm-3">Expected Result</dt>
            <dd class="col-sm-9">@Model.ExpectedResult</dd>

            <dt class="col-sm-3">Runs</dt>
            <dd class="col-sm-9">@ViewBag.TestRunCount</dd>

            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">@Model.CreatedDate.ToString("g")</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            @if ((int)ViewBag.TestRunCount == 0)
            {
                <input type="submit" value="Delete Permanently" class="btn btn-danger" />
            }
            else
            {
                <input type="submit" value="Delete Permanently" class="btn btn-danger" disabled />
            }
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>