@model DashboardViewModel
@inject BugTrack.Services.BugStatusService BugStatusService

@{
    ViewData["Title"] = "Dashboard";
    var priorityTotal = Math.Max(Model.TotalBugs, 1);
    Func<int, string> priorityBar = count => $"{Math.Round(count / (double)priorityTotal * 100)}%";
}

<div class="page-head">
    <div>
        <div class="page-kicker">QA Command Center</div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-sub">Bugs, test cases and execution signal, at a glance.</p>
    </div>
    <div class="page-actions">
        <a asp-controller="TestCases" asp-action="Create" class="btn btn-outline-primary">
            <i class="bi bi-plus-lg"></i> New Test Case
        </a>
        <a asp-controller="Bugs" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Log New Bug
        </a>
    </div>
</div>

<div class="stat-grid">
    <div class="stat-tile">
        <div class="stat-label">Total Bugs</div>
        <div class="stat-value accent">@Model.TotalBugs</div>
        <div class="stat-foot"><i class="bi bi-bug"></i> logged defects</div>
    </div>
    <div class="stat-tile">
        <div class="stat-label">Open Bugs</div>
        <div class="stat-value ember">@Model.OpenBugs</div>
        <div class="stat-foot"><i class="bi bi-kanban"></i> unresolved</div>
    </div>
    <div class="stat-tile">
        <div class="stat-label">Test Cases</div>
        <div class="stat-value">@Model.TotalTestCases</div>
        <div class="stat-foot"><i class="bi bi-list-check"></i> in the suite</div>
    </div>
    <div class="stat-tile">
        <div class="stat-label">Pass Rate</div>
        <div class="stat-value">@Model.PassRate.ToString("F1")<small>%</small></div>
        <div class="stat-foot"><i class="bi bi-graph-up-arrow"></i> of executed runs</div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card glass-panel h-100">
            <div class="card-header">
                <i class="bi bi-pie-chart"></i> Bugs by Priority
            </div>
            <div class="card-body">
                <div class="bar-row">
                    <div class="bar-label"><span class="badge bg-success">&nbsp;</span> Low</div>
                    <div class="bar-track"><div class="bar-fill green" style="width: @priorityBar(Model.BugsByPriorityLow)"></div></div>
                    <div class="bar-count">@Model.BugsByPriorityLow</div>
                </div>
                <div class="bar-row">
                    <div class="bar-label"><span class="badge bg-info">&nbsp;</span> Medium</div>
                    <div class="bar-track"><div class="bar-fill" style="width: @priorityBar(Model.BugsByPriorityMedium)"></div></div>
                    <div class="bar-count">@Model.BugsByPriorityMedium</div>
                </div>
                <div class="bar-row">
                    <div class="bar-label"><span class="badge bg-warning">&nbsp;</span> High</div>
                    <div class="bar-track"><div class="bar-fill ember" style="width: @priorityBar(Model.BugsByPriorityHigh)"></div></div>
                    <div class="bar-count">@Model.BugsByPriorityHigh</div>
                </div>
                <div class="bar-row mb-2">
                    <div class="bar-label"><span class="badge bg-danger">&nbsp;</span> Critical</div>
                    <div class="bar-track"><div class="bar-fill rose" style="width: @priorityBar(Model.BugsByPriorityCritical)"></div></div>
                    <div class="bar-count">@Model.BugsByPriorityCritical</div>
                </div>
                <a asp-controller="Bugs" asp-action="Index" class="btn btn-sm btn-outline-primary mt-2">
                    View All Bugs <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card glass-panel h-100">
            <div class="card-header">
                <i class="bi bi-kanban"></i> Bugs by Status
            </div>
            <div class="card-body">
                <div class="chip-cloud">
                    @foreach (var status in Model.BugsByStatus)
                    {
                        var chipClass = status.Key switch
                        {
                            BugStatus.New => "primary",
                            BugStatus.InProgress => "warning",
                            BugStatus.Fixed => "info",
                            BugStatus.Retest => "warning",
                            BugStatus.Closed => "success",
                            BugStatus.Reopened => "danger",
                            _ => ""
                        };
                        <span class="status-chip @chipClass">
                            @BugStatusService.GetStatusDisplayName(status.Key)
                            <span class="count">@status.Value</span>
                        </span>
                    }
                </div>
                <p class="text-muted mt-4 mb-0" style="font-size:.85rem;">
                    <i class="bi bi-info-circle"></i> Closed bugs stay on the register for the audit trail.
                </p>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card glass-panel h-100">
            <div class="card-header">
                <i class="bi bi-clock-history"></i> Recent Test Runs
            </div>
            <div class="card-body">
                @if (Model.RecentTestRuns.Any())
                {
                    <div class="ticket">
                        <div class="ticket-title">
                            <span>QA TICKET · LAST 5</span>
                            <time>@DateTime.Now.ToString("dd MMM yyyy")</time>
                        </div>
                        @foreach (var run in Model.RecentTestRuns.Take(5))
                        {
                            <div class="ticket-row">
                                <span class="k">@run.TestCase.Title</span>
                                <span class="badge @(run.Result == TestResult.Pass ? "bg-success" : run.Result == TestResult.Fail ? "bg-danger" : "bg-warning")">
                                    @run.Result
                                </span>
                            </div>
                            <div class="ticket-row" style="border-bottom:0;padding-top:0;font-size:.74rem;">
                                <span class="k">by @run.ExecutedBy</span>
                                <span class="v">@run.ExecutedDate.ToString("g")</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No recent test runs. Kick off your first execution from a test case.</p>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card glass-panel h-100">
            <div class="card-header">
                <i class="bi bi-clock-history"></i> Recent Bugs
            </div>
            <div class="card-body">
                @if (Model.RecentBugs.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var bug in Model.RecentBugs.Take(5))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-1">
                                <div>
                                    <a asp-controller="Bugs" asp-action="Details" asp-route-id="@bug.Id">
                                        <strong>@bug.Title</strong>
                                    </a>
                                    <div class="font-mono" style="font-size:.72rem;color:var(--ink-mute);margin-top:.2rem;">
                                        @BugStatusService.GetStatusDisplayName(bug.Status) · @bug.Priority
                                    </div>
                                </div>
                                <span class="badge @(bug.Severity == BugSeverity.Blocker ? "bg-danger" : bug.Severity == BugSeverity.Critical || bug.Severity == BugSeverity.Major ? "bg-warning" : "bg-info")">
                                    @bug.Severity
                                </span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">No bugs logged yet.</p>
                }
            </div>
        </div>
    </div>
</div>