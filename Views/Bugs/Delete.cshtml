@model Bug

@{
    ViewData["Title"] = $"Delete Bug #{Model.Id}";
}

<div class="page-head">
    <div>
        <div class="page-kicker" style="color:var(--danger);">Destructive Action</div>
        <h1 class="page-title">Delete Bug</h1>
        <p class="page-sub">Removing a defect is permanent. Review before committing.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Details
        </a>
    </div>
</div>

<div class="alert alert-danger">
    <h5><i class="bi bi-exclamation-triangle"></i> Are you sure you want to delete this bug?</h5>
    <p class="mb-0">This action cannot be undone.</p>
</div>

@if ((int)ViewBag.LinkedRunCount > 0)
{
    <div class="alert alert-warning">
        <h6><i class="bi bi-exclamation-triangle"></i> This bug is linked to @ViewBag.LinkedRunCount test run(s).</h6>
        <p class="mb-0">Bugs with linked test runs cannot be deleted, because test execution history must be preserved. Remove the link on the associated test run before deleting.</p>
    </div>
}

<div class="card glass-panel">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Priority</dt>
            <dd class="col-sm-9">@Model.Priority</dd>

            <dt class="col-sm-3">Severity</dt>
            <dd class="col-sm-9">@Model.Severity</dd>

            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">@Model.CreatedDate.ToString("g")</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            @if ((int)ViewBag.LinkedRunCount == 0)
            {
                <input type="submit" value="Delete Permanently" class="btn btn-danger" />
            }
            else
            {
                <input type="submit" value="Delete Permanently" class="btn btn-danger" disabled />
            }
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>