@model Bug

@{
    ViewData["Title"] = $"Bug #{Model.Id} - {Model.Title}";
}

<div class="row">
    <div class="col-md-8">
        <h1>Bug #@Model.Id: @Model.Title</h1>
        <hr />

        <div class="row mb-3">
            <div class="col-md-3">
                <strong>Status</strong>
                <br />
                <span class="badge @(Model.Status == BugStatus.Closed ? "bg-success" : Model.Status == BugStatus.New ? "bg-primary" : "bg-warning")">
                    @Model.Status
                </span>
            </div>
            <div class="col-md-3">
                <strong>Priority</strong>
                <br />
                <span class="badge @(Model.Priority == BugPriority.Critical ? "bg-danger" : Model.Priority == BugPriority.High ? "bg-warning" : "bg-info")">
                    @Model.Priority
                </span>
            </div>
            <div class="col-md-3">
                <strong>Severity</strong>
                <br />
                <span class="badge @(Model.Severity == BugSeverity.Blocker || Model.Severity == BugSeverity.Critical ? "bg-danger" : Model.Severity == BugSeverity.Major ? "bg-warning" : "bg-secondary")">
                    @Model.Severity
                </span>
            </div>
            <div class="col-md-3">
                <strong>Created</strong>
                <br />
                @Model.CreatedDate.ToString("g")
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Description</div>
            <div class="card-body">
                <p>@Model.Description</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.StepsToReproduce))
        {
            <div class="card mb-3">
                <div class="card-header">Steps to Reproduce</div>
                <div class="card-body">
                    <pre>@Model.StepsToReproduce</pre>
                </div>
            </div>
        }

        @if (Model.LinkedTestRun != null)
        {
            <div class="card mb-3">
                <div class="card-header">Linked Test Run</div>
                <div class="card-body">
                    <p>This bug was found while executing test case: <strong>@Model.LinkedTestRun.TestCase.Title</strong></p>
                    <p>Executed by: @Model.LinkedTestRun.ExecutedBy on @Model.LinkedTestRun.ExecutedDate.ToString("g")</p>
                    <a asp-controller="TestRuns" asp-action="Details" asp-route-id="@Model.LinkedTestRun.Id" class="btn btn-sm btn-info">
                        View Test Run
                    </a>
                </div>
            </div>
        }

        <div class="mt-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">Actions</div>
            <div class="card-body">
                <h6>Change Status</h6>
                <div class="btn-group-vertical w-100" role="group">
                    @foreach (var status in ViewBag.AvailableTransitions)
                    {
                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="newStatus" value="@status" />
                            <button type="submit" class="btn btn-outline-secondary w-100 mb-1">
                                Move to @status
                            </button>
                        </form>
                    }
                    @if (!ViewBag.AvailableTransitions.Any())
                    {
                        <p class="text-muted">No status changes available</p>
                    }
                </div>
                <hr />
                <div class="d-grid gap-2">
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                        <i class="bi bi-trash"></i> Delete Bug
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>