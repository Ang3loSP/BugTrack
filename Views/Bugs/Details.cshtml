@model Bug
@inject BugTrack.Services.BugStatusService BugStatusService

@{
    ViewData["Title"] = $"Bug #{Model.Id} - {Model.Title}";
}

<div class="page-head">
    <div>
        <div class="page-kicker">Defect #@Model.Id.ToString("D4")</div>
        <h1 class="page-title">@Model.Title</h1>
        <div class="meta-line">
            <span>logged <strong>@Model.CreatedDate.ToString("g")</strong></span>
            <span>assigned to <strong>@(Model.AssignedTo ?? "Unassigned")</strong></span>
            <span>id <strong>@Model.Id</strong></span>
        </div>
    </div>
    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="meta-chip-group">
    <span class="meta-chip">
        <i class="bi bi-circle-fill" style="font-size:.5rem;"></i> Status
        <span class="badge @(Model.Status == BugStatus.Closed ? "bg-success" : Model.Status == BugStatus.New ? "bg-primary" : "bg-warning")">
            @BugStatusService.GetStatusDisplayName(Model.Status)
        </span>
    </span>
    <span class="meta-chip">
        <i class="bi bi-flag"></i> Priority
        <span class="badge @(Model.Priority == BugPriority.Critical ? "bg-danger" : Model.Priority == BugPriority.High ? "bg-warning" : "bg-info")">
            @Model.Priority
        </span>
    </span>
    <span class="meta-chip">
        <i class="bi bi-shield-exclamation"></i> Severity
        <span class="badge @(Model.Severity == BugSeverity.Blocker || Model.Severity == BugSeverity.Critical ? "bg-danger" : Model.Severity == BugSeverity.Major ? "bg-warning" : "bg-secondary")">
            @Model.Severity
        </span>
    </span>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card glass-panel mb-4">
            <div class="card-header"><i class="bi bi-card-text"></i> Description</div>
            <div class="card-body">
                <p style="white-space:pre-wrap;margin:0;">@Model.Description</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.StepsToReproduce))
        {
            <div class="card glass-panel mb-4">
                <div class="card-header"><i class="bi bi-list-ol"></i> Steps to Reproduce</div>
                <div class="card-body">
                    <pre>@Model.StepsToReproduce</pre>
                </div>
            </div>
        }

        @if (Model.LinkedTestRun != null)
        {
            <div class="card glass-panel mb-4">
                <div class="card-header"><i class="bi bi-link-45deg"></i> Linked Test Run</div>
                <div class="card-body">
                    <p>Found while executing <strong>@Model.LinkedTestRun.TestCase.Title</strong></p>
                    <p class="font-mono" style="font-size:.85rem;color:var(--ink-mute);">
                        executed by @Model.LinkedTestRun.ExecutedBy · @Model.LinkedTestRun.ExecutedDate.ToString("g")
                    </p>
                    <a asp-controller="TestRuns" asp-action="Details" asp-route-id="@Model.LinkedTestRun.Id" class="btn btn-sm btn-info">
                        <i class="bi bi-eye"></i> View Test Run
                    </a>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card glass-panel">
            <div class="card-header"><i class="bi bi-arrow-repeat"></i> Status Actions</div>
            <div class="card-body">
                <p class="font-mono" style="font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-mute);margin-bottom:.75rem;">
                    Move to
                </p>
                <div class="btn-group-vertical w-100" role="group">
                    @foreach (var status in ViewBag.AvailableTransitions)
                    {
                        <form asp-action="UpdateStatus" method="post" class="d-block">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="newStatus" value="@status" />
                            <button type="submit" class="btn btn-outline-secondary w-100 mb-1">
                                Move to @BugStatusService.GetStatusDisplayName(status)
                            </button>
                        </form>
                    }
                    @if (ViewBag.AvailableTransitions.Count == 0)
                    {
                        <p class="text-muted text-center py-3">No status changes available</p>
                    }
                </div>
                <hr />
                <div class="d-grid gap-2">
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                        <i class="bi bi-trash"></i> Delete Bug
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>