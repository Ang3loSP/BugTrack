@model BugListViewModel
@inject BugTrack.Services.BugStatusService BugStatusService

@{
    ViewData["Title"] = "Bugs";
}

<div class="page-head">
    <div>
        <div class="page-kicker">Defect Register</div>
        <h1 class="page-title">Bugs</h1>
        <p class="page-sub">Filter, inspect and track defects through the lifecycle.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Log New Bug
        </a>
    </div>
</div>

<div class="card glass-panel mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select asp-for="FilterStatus" class="form-select" asp-items="Html.GetEnumSelectList<BugStatus>()">
                    <option value="">All</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Priority</label>
                <select asp-for="FilterPriority" class="form-select" asp-items="Html.GetEnumSelectList<BugPriority>()">
                    <option value="">All</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Severity</label>
                <select asp-for="FilterSeverity" class="form-select" asp-items="Html.GetEnumSelectList<BugSeverity>()">
                    <option value="">All</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Search</label>
                <div class="input-group">
                    <input asp-for="SearchTerm" class="form-control" placeholder="Search bugs..." />
                    <button type="submit" class="btn btn-primary" aria-label="Search">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Severity</th>
                <th>Created</th>
                <th>Assigned To</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Bugs.Any())
            {
                @foreach (var bug in Model.Bugs)
                {
                    <tr>
                        <td class="id-cell">#@bug.Id</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@bug.Id"><strong>@bug.Title</strong></a>
                        </td>
                        <td>
                            <span class="badge @(bug.Status == BugStatus.Closed ? "bg-success" : bug.Status == BugStatus.New ? "bg-primary" : "bg-warning")">
                                @BugStatusService.GetStatusDisplayName(bug.Status)
                            </span>
                        </td>
                        <td>
                            <span class="badge @(bug.Priority == BugPriority.Critical ? "bg-danger" : bug.Priority == BugPriority.High ? "bg-warning" : "bg-info")">
                                @bug.Priority
                            </span>
                        </td>
                        <td>
                            <span class="badge @(bug.Severity == BugSeverity.Blocker || bug.Severity == BugSeverity.Critical ? "bg-danger" : bug.Severity == BugSeverity.Major ? "bg-warning" : "bg-secondary")">
                                @bug.Severity
                            </span>
                        </td>
                        <td class="font-mono" style="font-size:.85rem;">@bug.CreatedDate.ToString("d")</td>
                        <td>@(bug.AssignedTo ?? "Unassigned")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@bug.Id" class="btn btn-sm btn-outline-primary" aria-label="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@bug.Id" class="btn btn-sm btn-outline-danger" aria-label="Delete">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-5">
                        No bugs found. <a asp-controller="Bugs" asp-action="Create">Log the first one</a>.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>